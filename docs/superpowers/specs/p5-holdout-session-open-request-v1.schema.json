{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agents-study.invalid/schemas/p5-holdout-session-open-request-v1",
  "title": "Stage 5 holdout session open request v1",
  "description": "One capability redemption request sent over an authenticated protected runtime-to-custodian channel. The bearer token is transient request material and must never be persisted or copied into evidence.",
  "$comment": "A valid shape does not prove token entropy, caller workload identity, grant signature/current key status, token-to-grant equality, scope equality, capability state, or idempotency. The custodian authenticates the runtime caller independently, verifies the registry-signed capability_grant and token hash, recomputes scope_sha256, atomically creates at most one session per capability_id, and permits response recovery only for the identical redeem_request_id and request scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "redemption"],
  "properties": {
    "schema": { "const": "p5-holdout-session-open-request-v1" },
    "redemption": { "$ref": "#/$defs/redemption" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capabilityToken": {
      "type": "string",
      "description": "Exactly 32 cryptographically random bytes encoded as unpadded base64url; schema shape cannot prove randomness.",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "redemption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "capability_token",
        "capability_grant",
        "redeem_request_id",
        "run_id",
        "reservation_event_id",
        "frozen_spec_sha256",
        "candidate_hash",
        "build_provenance_sha256",
        "runtime_admission_sha256",
        "platform_manifest_digest",
        "runtime_id",
        "runtime_subject",
        "custodian_audience",
        "dataset_sha256",
        "session_policy_sha256",
        "capability_expires_at_utc",
        "max_attempts",
        "operation",
        "scope_sha256"
      ],
      "properties": {
        "capability_id": { "$ref": "#/$defs/id" },
        "capability_token": { "$ref": "#/$defs/capabilityToken" },
        "capability_grant": {
          "$ref": "https://ai-agents-study.invalid/schemas/p5-holdout-capability-grant-v1"
        },
        "redeem_request_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "reservation_event_id": { "$ref": "#/$defs/id" },
        "frozen_spec_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_hash": { "$ref": "#/$defs/sha256" },
        "build_provenance_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_admission_sha256": { "$ref": "#/$defs/sha256" },
        "platform_manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "runtime_id": { "$ref": "#/$defs/id" },
        "runtime_subject": { "$ref": "#/$defs/id" },
        "custodian_audience": { "$ref": "#/$defs/id" },
        "dataset_sha256": { "$ref": "#/$defs/sha256" },
        "session_policy_sha256": { "$ref": "#/$defs/sha256" },
        "capability_expires_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
        },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "operation": { "const": "read_next_attempt" },
        "scope_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
