{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agents-study.invalid/schemas/stage5-decision-challenge-events-v2",
  "title": "Stage 5 decision challenge event records v2",
  "description": "Append-only event and receipt shapes only. V2 binds a digest of retained evidence for every trigger; ordering, signatures, event-to-receipt bindings, target digest, current source heads, challenge state and fresh verification are semantic checks.",
  "oneOf": [{ "$ref": "#/$defs/challengeRecord" }, { "$ref": "#/$defs/resolutionRecord" }],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "recordType": { "enum": ["human-acceptance", "release-authorization"] },
    "challengeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "event", "idempotency_key", "append_receipt"],
      "properties": {
        "schema": { "const": "stage5-decision-challenge-v2" },
        "event": { "$ref": "#/$defs/challenged" },
        "idempotency_key": { "$ref": "#/$defs/id" },
        "append_receipt": {
          "allOf": [
            { "$ref": "stage5-decision-consumption-common-v1#/$defs/appendReceipt" },
            {
              "type": "object",
              "properties": { "record_type": { "const": "decision-challenged" } }
            }
          ]
        }
      }
    },
    "resolutionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "event", "idempotency_key", "append_receipt"],
      "properties": {
        "schema": { "const": "stage5-decision-challenge-resolved-v2" },
        "event": { "$ref": "#/$defs/resolved" },
        "idempotency_key": { "$ref": "#/$defs/id" },
        "append_receipt": {
          "allOf": [
            { "$ref": "stage5-decision-consumption-common-v1#/$defs/appendReceipt" },
            {
              "type": "object",
              "properties": { "record_type": { "const": "decision-challenge-resolved" } }
            }
          ]
        }
      }
    },
    "challenged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "challenge_id",
        "target_record_type",
        "target_record_id",
        "target_record_sha256",
        "reason_code",
        "observed_at_utc",
        "initiator",
        "trigger",
        "trigger_evidence_sha256"
      ],
      "properties": {
        "event_type": { "const": "decision-challenged" },
        "challenge_id": { "$ref": "#/$defs/id" },
        "target_record_type": { "$ref": "#/$defs/recordType" },
        "target_record_id": { "$ref": "#/$defs/id" },
        "target_record_sha256": { "$ref": "#/$defs/digest" },
        "reason_code": { "$ref": "#/$defs/id" },
        "observed_at_utc": { "$ref": "#/$defs/timestamp" },
        "initiator": { "$ref": "#/$defs/initiator" },
        "trigger_evidence_sha256": { "$ref": "#/$defs/digest" },
        "trigger": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source_id", "source_sequence", "source_head_sha256"],
              "properties": {
                "kind": { "const": "source-state" },
                "source_id": { "$ref": "#/$defs/id" },
                "source_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "source_head_sha256": { "$ref": "#/$defs/digest" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "policy_id", "rule_id"],
              "properties": {
                "kind": { "const": "policy" },
                "policy_id": { "$ref": "#/$defs/id" },
                "rule_id": { "$ref": "#/$defs/id" }
              }
            }
          ]
        }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "resolution_id",
        "challenge_id",
        "challenge_event_sha256",
        "target_record_type",
        "target_record_id",
        "target_record_sha256",
        "fresh_decision_id",
        "fresh_decision_receipt_sha256",
        "resolution_evidence_sha256",
        "initiator"
      ],
      "properties": {
        "event_type": { "const": "decision-challenge-resolved" },
        "resolution_id": { "$ref": "#/$defs/id" },
        "challenge_id": { "$ref": "#/$defs/id" },
        "challenge_event_sha256": { "$ref": "#/$defs/digest" },
        "target_record_type": { "$ref": "#/$defs/recordType" },
        "target_record_id": { "$ref": "#/$defs/id" },
        "target_record_sha256": { "$ref": "#/$defs/digest" },
        "fresh_decision_id": { "$ref": "#/$defs/id" },
        "fresh_decision_receipt_sha256": { "$ref": "#/$defs/digest" },
        "resolution_evidence_sha256": { "$ref": "#/$defs/digest" },
        "initiator": { "$ref": "#/$defs/initiator" }
      }
    },
    "initiator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "service_id"],
          "properties": {
            "kind": { "const": "service" },
            "service_id": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "subject_id",
            "required_role",
            "identity_decision_ref",
            "identity_decision_sha256"
          ],
          "properties": {
            "kind": { "const": "human" },
            "subject_id": { "$ref": "#/$defs/id" },
            "required_role": { "const": "stage5_decision_challenger" },
            "identity_decision_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
            "identity_decision_sha256": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    }
  }
}
