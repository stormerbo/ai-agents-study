{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agents-study.invalid/schemas/stage5-source-probe-journal-page-v1",
  "title": "Stage 5 authenticated monitor probe journal page v1",
  "description": "A nonce-bound, signed page from the verifier-pinned per-source probe journal. Completeness, page sequencing, entry digests/signatures, current head freshness, and rollback floors are semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment_id",
    "source_id",
    "monitor_service_id",
    "query_nonce",
    "requested_from_sequence",
    "requested_to_sequence",
    "entries",
    "current_head_sequence",
    "current_head_sha256",
    "observed_at_utc",
    "signature_profile",
    "signing_key_id",
    "signature"
  ],
  "properties": {
    "schema": { "const": "stage5-source-probe-journal-page-v1" },
    "environment_id": { "$ref": "stage5-decision-consumption-common-v1#/$defs/id" },
    "source_id": { "$ref": "stage5-decision-consumption-common-v1#/$defs/id" },
    "monitor_service_id": { "$ref": "stage5-decision-consumption-common-v1#/$defs/id" },
    "query_nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "requested_from_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "requested_to_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "stage5-source-outage-episode-v1#/$defs/probe" }
    },
    "current_head_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "current_head_sha256": { "$ref": "stage5-decision-consumption-common-v1#/$defs/digest" },
    "observed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "signature_profile": { "const": "ed25519-jcs-stage5-source-probe-journal-page-v1" },
    "signing_key_id": { "$ref": "stage5-decision-consumption-common-v1#/$defs/id" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
