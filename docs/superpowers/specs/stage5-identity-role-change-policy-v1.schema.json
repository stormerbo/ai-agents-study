{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agents-study.invalid/schemas/stage5-identity-role-change-policy-v1",
  "title": "Stage 5 identity role-change authorization policy v1",
  "description": "Verifier-pinned policy that determines which subjects may propose and approve identity role or key changes in one environment/log scope.",
  "$comment": "The verifier constructs policy_core by copying this object and omitting bootstrap.approval_sha256 and transition_approval_sha256, then computes policy_sha256 = SHA-256(JCS(policy_core)); these omissions prevent the bootstrap/transition approval from creating a digest cycle while all policy rules and the approved transition scope remain bound. The expected digest comes from verifier-controlled configuration, not from this document or the identity source. Every role/action pair and the key-change rules must be present exactly once; duplicate or missing pairs are semantic errors. The root signature over policy_sha256 authorizes the exact ordered initial_role_changes list and is the only authorization path for the genesis events; each genesis event must match one list entry exactly and carry a root-signed approval over its exact event intent. Subsequent changes use the ordinary policy rules. Bootstrap authority and approval_sha256 must resolve to an independently verified out-of-band root approval over policy_sha256. Policy replacement requires a transition approval over the new policy_sha256, authorized under the previously pinned policy, and a separate verifier pin update. Schema validation does not verify policy signatures, approval, completeness, rule uniqueness, or identity role status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "version",
    "environment_id",
    "log_id",
    "rules",
    "controls",
    "bootstrap"
  ],
  "properties": {
    "schema": { "const": "stage5-identity-role-change-policy-v1" },
    "policy_id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "environment_id": { "$ref": "#/$defs/id" },
    "log_id": { "$ref": "#/$defs/id" },
    "supersedes_policy_sha256": { "$ref": "#/$defs/digest" },
    "transition_record_id": { "$ref": "#/$defs/id" },
    "transition_approval_sha256": { "$ref": "#/$defs/digest" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_approver_must_differ",
        "target_must_differ_from_actor_and_approver",
        "approval_must_bind_expected_head"
      ],
      "properties": {
        "actor_approver_must_differ": { "const": true },
        "target_must_differ_from_actor_and_approver": { "const": true },
        "approval_must_bind_expected_head": { "const": true }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_record_id",
        "authority_subject_id",
        "authority_key_id",
        "approval_sha256",
        "approved_at_utc",
        "initial_role_changes"
      ],
      "properties": {
        "bootstrap_record_id": { "$ref": "#/$defs/id" },
        "authority_subject_id": { "$ref": "#/$defs/id" },
        "authority_key_id": { "$ref": "#/$defs/id" },
        "approval_sha256": { "$ref": "#/$defs/digest" },
        "approved_at_utc": { "$ref": "#/$defs/utcTimestamp" },
        "initial_role_changes": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/initialRoleChange" },
          "contains": {
            "type": "object",
            "properties": {
              "action": { "const": "role-granted" },
              "role": { "const": "stage5_governance_administrator" }
            },
            "required": ["action", "role"]
          },
          "minContains": 1,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "action": { "const": "role-granted" },
                  "role": { "const": "stage5_risk_owner" }
                },
                "required": ["action", "role"]
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "action": { "const": "key-bound" } },
                "required": ["action"]
              },
              "minContains": 1
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 1 } }, "required": ["version"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["supersedes_policy_sha256"] },
            { "required": ["transition_record_id"] },
            { "required": ["transition_approval_sha256"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 }
        },
        "required": ["version"]
      },
      "then": {
        "required": [
          "supersedes_policy_sha256",
          "transition_record_id",
          "transition_approval_sha256"
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "role": {
      "enum": [
        "stage5_risk_owner",
        "stage5_independent_reviewer",
        "stage5_governance_administrator",
        "stage5_acceptance_authority",
        "stage5_release_authority",
        "stage5_decision_challenger"
      ]
    },
    "roleList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role" }
    },
    "initialRoleChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "role_change_id",
        "action",
        "target_subject_id",
        "role",
        "signing_key_id",
        "key_fingerprint_sha256"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "role_change_id": { "$ref": "#/$defs/id" },
        "action": { "enum": ["role-granted", "key-bound"] },
        "target_subject_id": { "$ref": "#/$defs/id" },
        "role": {
          "anyOf": [{ "$ref": "#/$defs/role" }, { "type": "null" }]
        },
        "signing_key_id": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "key_fingerprint_sha256": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "role-granted" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "role": { "$ref": "#/$defs/role" },
              "signing_key_id": { "type": "null" },
              "key_fingerprint_sha256": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "key-bound" } },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "role": { "type": "null" },
              "signing_key_id": { "$ref": "#/$defs/id" },
              "key_fingerprint_sha256": { "$ref": "#/$defs/digest" }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "role", "actor_roles", "approver_roles"],
      "properties": {
        "action": {
          "enum": ["role-granted", "role-revoked", "key-bound", "key-revoked"]
        },
        "role": {
          "anyOf": [{ "$ref": "#/$defs/role" }, { "type": "null" }]
        },
        "actor_roles": { "$ref": "#/$defs/roleList" },
        "approver_roles": { "$ref": "#/$defs/roleList" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": { "enum": ["role-granted", "role-revoked"] }
            },
            "required": ["action"]
          },
          "then": { "properties": { "role": { "$ref": "#/$defs/role" } } }
        },
        {
          "if": {
            "properties": {
              "action": { "enum": ["key-bound", "key-revoked"] }
            },
            "required": ["action"]
          },
          "then": { "properties": { "role": { "type": "null" } } }
        }
      ]
    }
  }
}
