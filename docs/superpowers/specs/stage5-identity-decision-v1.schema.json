{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agents-study.invalid/schemas/stage5-identity-decision-v1",
  "title": "Stage 5 identity-source decision record v1",
  "description": "Auditable response shape for preflight and post-commit signer identity decisions.",
  "$comment": "decision_sha256 is SHA-256(JCS(the complete decision record with decision_sha256 omitted)). The response must be stored immutably at decision_ref by the pinned source. The verifier recomputes the digest and checks the record against its request, the signed registry event, and current identity state. JSON Schema does not establish source authenticity, semantic authorization, calendar validity, freshness, or chronology.",
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/commonDecision" },
    {
      "if": {
        "properties": { "schema": { "const": "stage5-identity-preflight-decision-v1" } },
        "required": ["schema"]
      },
      "then": {
        "required": ["challenge_nonce", "role_valid_now", "issued_at_utc", "valid_until_utc"],
        "properties": {
          "schema": { "const": "stage5-identity-preflight-decision-v1" },
          "role_valid_now": { "type": "boolean" },
          "challenge_nonce": { "$ref": "#/$defs/nonce" },
          "issued_at_utc": { "$ref": "#/$defs/utcTimestamp" },
          "valid_until_utc": { "$ref": "#/$defs/utcTimestamp" }
        },
        "not": {
          "anyOf": [
            { "required": ["authority_sequence"] },
            { "required": ["authority_recorded_at"] },
            { "required": ["role_valid_at_record_time"] },
            { "required": ["evaluated_at_utc"] }
          ]
        }
      },
      "else": {
        "required": [
          "authority_sequence",
          "authority_recorded_at",
          "role_valid_at_record_time",
          "evaluated_at_utc"
        ],
        "properties": {
          "schema": { "const": "stage5-identity-record-time-decision-v1" },
          "authority_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "authority_recorded_at": { "$ref": "#/$defs/utcTimestamp" },
          "role_valid_at_record_time": { "type": "boolean" },
          "evaluated_at_utc": { "$ref": "#/$defs/utcTimestamp" }
        },
        "not": {
          "anyOf": [
            { "required": ["challenge_nonce"] },
            { "required": ["issued_at_utc"] },
            { "required": ["valid_until_utc"] },
            { "required": ["role_valid_now"] }
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonce": {
      "type": "string",
      "minLength": 22,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "commonDecision": {
      "type": "object",
      "required": [
        "schema",
        "source_id",
        "decision_ref",
        "environment_id",
        "log_id",
        "run_id",
        "attestation_sha256",
        "subject_id",
        "signing_key_id",
        "required_role",
        "approval_policy_id",
        "verified_subject_id",
        "key_fingerprint_sha256",
        "role_grant_id",
        "credential_state_now",
        "revocation_sequence",
        "decision",
        "policy_version",
        "decision_sha256"
      ],
      "properties": {
        "schema": {
          "enum": [
            "stage5-identity-preflight-decision-v1",
            "stage5-identity-record-time-decision-v1"
          ]
        },
        "source_id": { "$ref": "#/$defs/id" },
        "decision_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "environment_id": { "$ref": "#/$defs/id" },
        "log_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "attestation_sha256": { "$ref": "#/$defs/sha256" },
        "subject_id": { "$ref": "#/$defs/id" },
        "signing_key_id": { "$ref": "#/$defs/id" },
        "required_role": {
          "enum": [
            "stage5_risk_owner",
            "stage5_independent_reviewer",
            "stage5_governance_administrator"
          ]
        },
        "approval_policy_id": { "$ref": "#/$defs/id" },
        "verified_subject_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "key_fingerprint_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "role_grant_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "credential_state_now": {
          "enum": ["active", "disabled", "revoked", "unknown"]
        },
        "revocation_sequence": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "decision": { "enum": ["allow", "deny"] },
        "policy_version": { "$ref": "#/$defs/id" },
        "decision_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
