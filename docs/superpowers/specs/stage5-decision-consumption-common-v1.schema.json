{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agents-study.invalid/schemas/stage5-decision-consumption-common-v1",
  "title": "Stage 5 downstream decision-consumption common types v1",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "snapshot_id",
        "environment_id",
        "assurance_profile",
        "snapshot_started_at_utc",
        "snapshot_completed_at_utc",
        "maximum_snapshot_skew_seconds",
        "registry",
        "usage_ledger",
        "governance",
        "identity_source",
        "witness"
      ],
      "properties": {
        "schema": { "const": "stage5-decision-source-snapshot-v1" },
        "snapshot_id": { "$ref": "#/$defs/id" },
        "environment_id": { "$ref": "#/$defs/id" },
        "assurance_profile": {
          "enum": ["single-authority-v1", "dual-witness-v1"]
        },
        "snapshot_started_at_utc": { "$ref": "#/$defs/utcTimestamp" },
        "snapshot_completed_at_utc": { "$ref": "#/$defs/utcTimestamp" },
        "maximum_snapshot_skew_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "trust_bundle_sha256",
            "key_status_sequence",
            "log_head_sequence",
            "log_head_sha256",
            "observed_at_utc"
          ],
          "properties": {
            "source_id": { "$ref": "#/$defs/id" },
            "trust_bundle_sha256": { "$ref": "#/$defs/digest" },
            "key_status_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "log_head_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "log_head_sha256": { "$ref": "#/$defs/digest" },
            "observed_at_utc": { "$ref": "#/$defs/utcTimestamp" }
          }
        },
        "usage_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "ledger_id",
            "trust_bundle_sha256",
            "key_status_sequence",
            "closed_sequence",
            "closed_head_sha256",
            "observed_at_utc"
          ],
          "properties": {
            "source_id": { "$ref": "#/$defs/id" },
            "ledger_id": { "$ref": "#/$defs/id" },
            "trust_bundle_sha256": { "$ref": "#/$defs/digest" },
            "key_status_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "closed_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "closed_head_sha256": { "$ref": "#/$defs/digest" },
            "observed_at_utc": { "$ref": "#/$defs/utcTimestamp" }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "log_id",
            "log_head_sequence",
            "log_head_sha256",
            "revocation_sequence",
            "observed_at_utc"
          ],
          "properties": {
            "source_id": { "$ref": "#/$defs/id" },
            "log_id": { "$ref": "#/$defs/id" },
            "log_head_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "log_head_sha256": { "$ref": "#/$defs/digest" },
            "revocation_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "observed_at_utc": { "$ref": "#/$defs/utcTimestamp" }
          }
        },
        "identity_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "decisions", "observed_at_utc"],
          "properties": {
            "source_id": { "$ref": "#/$defs/id" },
            "decisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decision_ref",
                  "decision_sha256",
                  "authorization_intent_sha256",
                  "decision_log_id",
                  "record_type",
                  "record_id",
                  "environment_id",
                  "subject_id",
                  "required_role",
                  "decision",
                  "revocation_sequence",
                  "policy_version",
                  "observed_at_utc"
                ],
                "properties": {
                  "decision_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
                  "decision_sha256": { "$ref": "#/$defs/digest" },
                  "authorization_intent_sha256": { "$ref": "#/$defs/digest" },
                  "decision_log_id": { "$ref": "#/$defs/id" },
                  "record_type": { "enum": ["human-acceptance", "release-authorization"] },
                  "record_id": { "$ref": "#/$defs/id" },
                  "environment_id": { "$ref": "#/$defs/id" },
                  "subject_id": { "$ref": "#/$defs/id" },
                  "required_role": { "$ref": "#/$defs/id" },
                  "decision": { "const": "allow" },
                  "revocation_sequence": {
                    "oneOf": [
                      { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                      { "type": "null" }
                    ]
                  },
                  "policy_version": { "$ref": "#/$defs/id" },
                  "observed_at_utc": { "$ref": "#/$defs/utcTimestamp" }
                }
              }
            },
            "observed_at_utc": { "$ref": "#/$defs/utcTimestamp" }
          }
        },
        "witness": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "sequence", "head_sha256", "observed_at_utc"],
              "properties": {
                "source_id": { "$ref": "#/$defs/id" },
                "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "head_sha256": { "$ref": "#/$defs/digest" },
                "observed_at_utc": { "$ref": "#/$defs/utcTimestamp" }
              }
            }
          ]
        }
      }
    },
    "appendReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "decision_log_id",
        "record_type",
        "record_id",
        "sequence",
        "previous_record_sha256",
        "record_sha256",
        "recorded_at_utc",
        "key_id",
        "signature_profile",
        "signature"
      ],
      "properties": {
        "schema": { "const": "stage5-decision-consumption-receipt-v1" },
        "decision_log_id": { "$ref": "#/$defs/id" },
        "record_type": {
          "enum": [
            "human-acceptance",
            "release-authorization",
            "decision-challenged",
            "decision-challenge-resolved",
            "deployment-operation"
          ]
        },
        "record_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "previous_record_sha256": { "$ref": "#/$defs/digest" },
        "record_sha256": { "$ref": "#/$defs/digest" },
        "recorded_at_utc": { "$ref": "#/$defs/utcTimestamp" },
        "key_id": { "$ref": "#/$defs/id" },
        "signature_profile": { "const": "ed25519-jcs-decision-consumption-receipt-v1" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
