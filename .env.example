# 本项目的 BYOK 中转端点不需要任何服务端厂商密钥。
# 用户自己的 API Key 只存在于其浏览器，请求经 /api/chat 转发给厂商后即丢弃。

# 中转端点总开关。设为 false 时 /api/chat 返回 503，用户可改用浏览器直连模式。
BYOK_RELAY_ENABLED=true

# 是否允许客户端传任意 baseUrl。默认禁止：
# 开放它等于开放一个通用 HTTP 代理，且带 SSRF 风险（可探测内网与云元数据端点）。
ALLOW_CUSTOM_BASE_URL=false

# 模型白名单的额外补充（JSON 数组）。用于不改代码、不重新部署就放行新模型。
# MODEL_ALLOWLIST_EXTRA=["claude-opus-5-5"]

# 单次请求的输出 token 上限（服务端强制，覆盖客户端传值）
MAX_OUTPUT_TOKENS_CEILING=4096
