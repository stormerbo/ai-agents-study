{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["experimentId", "runId", "evidenceType", "observedAt", "method", "observations", "limitations"],
  "properties": {
    "experimentId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "evidenceType": {"enum": ["deterministic-local", "postgres-integration", "real-online", "raw-replay", "synthetic-fixture", "official-documentation-review", "raw-observation-review"]},
    "observedAt": {"type": "string", "format": "date"},
    "method": {"type": "string", "minLength": 1},
    "observations": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "sourceBindings": {
      "type": "array",
      "minItems": 1,
      "description": "Optional for legacy runs. New run records should bind the execution entrypoint, implementation, dependencies, and tests to repository-relative SHA-256 values captured before execution. This does not attest the runtime environment cryptographically.",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"enum": ["entrypoint", "implementation", "dependency", "test"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
