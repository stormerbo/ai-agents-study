{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "lessonIds", "question", "type", "datasetVersion", "scorerVersion", "executionMode", "expectedInvariants", "resultPath", "status", "reviewedAt", "dependencyLockPath", "dependencyLockSha256"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "lessonIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "question": {"type": "string", "minLength": 1},
    "type": {"enum": ["deterministic-local", "postgres-integration", "real-online", "raw-replay", "synthetic-fixture", "official-documentation-review", "raw-observation-review"]},
    "codeLocator": {"$ref": "#/$defs/codeLocator"},
    "codeSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scriptPath": {"type": "string", "minLength": 1},
    "scriptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependencyLockPath": {"type": ["string", "null"]},
    "dependencyLockSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "datasetVersion": {"type": "string", "minLength": 1},
    "scorerVersion": {"type": "string", "minLength": 1},
    "executionMode": {"type": "string", "minLength": 1},
    "expectedInvariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "resultPath": {"type": "string", "minLength": 1},
    "status": {"enum": ["verified", "needs-review", "blocked"]},
    "reviewedAt": {"type": "string", "format": "date"},
    "online": {"type": "object"}
  },
  "allOf": [
    {"anyOf": [{"required": ["codeLocator", "codeSha256"]}, {"required": ["scriptPath", "scriptSha256"]}]},
    {"if": {"properties": {"dependencyLockPath": {"type": "string"}}}, "then": {"properties": {"dependencyLockSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "else": {"properties": {"dependencyLockSha256": {"type": "null"}}}}
  ],
  "$defs": {
    "codeLocator": {
      "type": "object",
      "required": ["path", "fence", "role"],
      "properties": {"path": {"type": "string"}, "fence": {"type": "integer", "minimum": 0}, "role": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
