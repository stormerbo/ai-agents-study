{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agents-study.invalid/schemas/independent-witness-receipt-v1",
  "title": "Independent witness receipt v1",
  "description": "A witness signature over one authority event and the witness's run-scoped predecessor chain. Structural validity does not prove independent observation or service identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "hash_profile",
    "witness_id",
    "authority_id",
    "environment_id",
    "log_id",
    "run_id",
    "authority_sequence",
    "authority_event_id",
    "authority_event_hash",
    "authority_entry_sha256",
    "witness_sequence",
    "previous_witness_receipt_sha256",
    "observed_at_utc",
    "key_id",
    "signature_algorithm",
    "signature_profile",
    "signature"
  ],
  "properties": {
    "schema": { "const": "stage5-independent-witness-receipt-v1" },
    "hash_profile": { "const": "jcs-rfc8785-v1" },
    "witness_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authority_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "environment_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "log_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authority_sequence": { "type": "integer", "minimum": 1 },
    "authority_event_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authority_event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_entry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "witness_sequence": { "type": "integer", "minimum": 1 },
    "previous_witness_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observed_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "signature_algorithm": { "const": "Ed25519" },
    "signature_profile": { "const": "ed25519-jcs-witness-receipt-v1" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
