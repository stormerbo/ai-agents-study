# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 但样例文件要提交 —— 它不含真实凭据，是给新环境看的模板
!.env.example

# 验证脚本的输出（含真实 API 响应，不提交）
/verify-output/

# 章 3 第 4 节「状态与恢复」示例的运行产物（正文里 STATE = "al-messages.json"）
/al-messages.json

# 视觉验证的临时产物（playwright 截图与快照）
/.playwright-cli/
/output/

# Pagefind 搜索索引（由 pnpm build-search 生成，不入库）
/public/pagefind/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
