{
  "name": "ai-agents-study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:jcs:interop": "node --test examples/p5-agent-delivery/evaluation/test_jcs_interop.mjs",
    "test:trust-bundle-schema": "node --test examples/p5-agent-delivery/evaluation/test_trust_bundle_schema.mjs",
    "test:trust-bundle-verifier": "node --test examples/p5-agent-delivery/evaluation/test_trust_bundle_verifier.mjs",
    "test:key-status-verifier": "node --test examples/p5-agent-delivery/evaluation/test_key_status_verifier.mjs",
    "test:registry-receipt-vectors": "node --test examples/p5-agent-delivery/evaluation/test_registry_receipt_vectors.mjs",
    "test:registry-receipt-chain": "node --test examples/p5-agent-delivery/evaluation/test_registry_receipt_chain.mjs",
    "test:computer-use": "node --test examples/computer-use-safety/test_controller.mjs",
    "test:stage5-governance-contract": "node --test docs/superpowers/specs/test-governance-schemas.mjs docs/superpowers/specs/test-stage5-governance-conformance.mjs docs/superpowers/specs/test-identity-signature-vectors.mjs docs/superpowers/specs/test-stage5-decision-signature-vectors.mjs docs/superpowers/specs/test-stage5-v7-digest-vectors.mjs docs/superpowers/specs/test-stage5-v7-lifecycle-conformance.mjs docs/superpowers/specs/test-stage5-v7-decision-conformance.mjs docs/superpowers/specs/test-stage5-v7-decision-receipt-conformance.mjs && uv run --frozen --project examples/p4-durable-support python -m unittest discover -s examples/p5-agent-delivery/evaluation -p test_canonicalization.py",
    "test:links": "node --test scripts/check-links.test.mjs",
    "test:watch": "vitest",
    "build-search": "node scripts/build-search.mjs",
    "depth-check": "node scripts/depth-check.mjs",
    "verify:depth": "node scripts/verify-depth-fixes.mjs --base=HEAD",
    "verify:evidence": "vitest run tests/evidence-registry.test.ts",
    "validate:handoff": "node scripts/validate-handoff-record.mjs",
    "verify:examples": "node scripts/verify-examples.mjs && pnpm test:jcs:interop && pnpm test:registry-receipt-vectors && pnpm test:registry-receipt-chain && pnpm test:trust-bundle-schema && pnpm test:trust-bundle-verifier && pnpm test:key-status-verifier && pnpm test:computer-use"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "clsx": "^2.1.1",
    "mermaid": "^12.0.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "canonicalize": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.15.4"
}
